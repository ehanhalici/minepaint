// fragment: brush_settings.dats icinde include edilir. Ayar metaverisi dosya duzeyinde sabit tablodur (govde yok).
#ifndef BRUSHSETTINGS_FILL_HATS
#define BRUSHSETTINGS_FILL_HATS

val g_settings = arrayref_make_arrpsz($arrpsz{MinePaintBrushSettingInfo}(
  @{cname= "opaque", name= "Opacity", constant= 0, min= 0.0f, def= 1.0f, max= 2.0f, tooltip= "0 means brush is transparent, 1 fully visible\n(also known as alpha or opacity)"},
  @{cname= "opaque_multiply", name= "Opacity multiply", constant= 0, min= 0.0f, def= 0.0f, max= 2.0f, tooltip= "This gets multiplied with opaque. You should only change the pressure input of this setting. Use 'opaque' instead to make opacity depend on speed.\nThis setting is responsible to stop painting when there is zero pressure. This is just a convention, the behaviour is identical to 'opaque'."},
  @{cname= "opaque_linearize", name= "Opacity linearize", constant= 1, min= 0.0f, def= 0.9f, max= 2.0f, tooltip= "Correct the nonlinearity introduced by blending multiple dabs on top of each other. This correction should get you a linear (\"natural\") pressure response when pressure is mapped to opaque_multiply, as it is usually done. 0.9 is good for standard strokes, set it smaller if your brush scatters a lot, or higher if you use dabs_per_second.\n0.0 the opaque value above is for the individual dabs\n1.0 the opaque value above is for the final brush stroke, assuming each pixel gets (dabs_per_radius*2) brushdabs on average during a stroke"},
  @{cname= "radius_logarithmic", name= "Radius", constant= 0, min= ~2.0f, def= 2.0f, max= 6.0f, tooltip= "Basic brush radius (logarithmic)\n 0.7 means 2 pixels\n 3.0 means 20 pixels"},
  @{cname= "hardness", name= "Hardness", constant= 0, min= 0.0f, def= 0.8f, max= 1.0f, tooltip= "Hard brush-circle borders (setting to zero will draw nothing). To reach the maximum hardness, you need to disable Pixel feather."},
  @{cname= "softness", name= "Softness", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Soften brush-circle from center to edge (setting to 1.0 will draw nothing)."},
  @{cname= "anti_aliasing", name= "Pixel feather", constant= 0, min= 0.0f, def= 1.0f, max= 5.0f, tooltip= "This setting decreases the hardness when necessary to prevent a pixel staircase effect (aliasing) by making the dab more blurred.\n 0.0 disable (for very strong erasers and pixel brushes)\n 1.0 blur one pixel (good value)\n 5.0 notable blur, thin strokes will disappear"},
  @{cname= "dabs_per_basic_radius", name= "Dabs per basic radius", constant= 0, min= 0.0f, def= 0.0f, max= 200.0f, tooltip= "How many dabs to draw while the pointer moves a distance of one brush radius (more precise: the base value of the radius)"},
  @{cname= "dabs_per_actual_radius", name= "Dabs per actual radius", constant= 0, min= 0.0f, def= 2.0f, max= 200.0f, tooltip= "Same as above, but the radius actually drawn is used, which can change dynamically"},
  @{cname= "dabs_per_second", name= "Dabs per second", constant= 0, min= 0.0f, def= 0.0f, max= 200.0f, tooltip= "Dabs to draw each second, no matter how far the pointer moves"},
  @{cname= "gridmap_scale", name= "GridMap Scale", constant= 0, min= ~10.0f, def= 0.0f, max= 10.0f, tooltip= "Changes the overall scale that the GridMap brush input operates on.\nLogarithmic (same scale as brush radius).\nA scale of 0 will make the grid 256x256 pixels."},
  @{cname= "gridmap_scale_x", name= "GridMap Scale X", constant= 0, min= 0.0f, def= 1.0f, max= 10.0f, tooltip= "Changes the scale that the GridMap brush input operates on - affects X axis only.\nThe range is 0-5x.\nThis allows you to stretch or compress the GridMap pattern."},
  @{cname= "gridmap_scale_y", name= "GridMap Scale Y", constant= 0, min= 0.0f, def= 1.0f, max= 10.0f, tooltip= "Changes the scale that the GridMap brush input operates on - affects Y axis only.\nThe range is 0-5x.\nThis allows you to stretch or compress the GridMap pattern."},
  @{cname= "radius_by_random", name= "Radius by random", constant= 0, min= 0.0f, def= 0.0f, max= 1.5f, tooltip= "Alter the radius randomly each dab. You can also do this with the by_random input on the radius setting. If you do it here, there are two differences:\n1) the opaque value will be corrected such that a big-radius dabs is more transparent\n2) it will not change the actual radius seen by dabs_per_actual_radius"},
  @{cname= "speed1_slowness", name= "Fine speed filter", constant= 0, min= 0.0f, def= 0.04f, max= 0.2f, tooltip= "How slow the input fine speed is following the real speed\n0.0 change immediately as your speed changes (not recommended, but try it)"},
  @{cname= "speed2_slowness", name= "Gross speed filter", constant= 0, min= 0.0f, def= 0.8f, max= 3.0f, tooltip= "Same as 'fine speed filter', but note that the range is different"},
  @{cname= "speed1_gamma", name= "Fine speed gamma", constant= 1, min= ~8.0f, def= 4.0f, max= 8.0f, tooltip= "This changes the reaction of the 'fine speed' input to extreme physical speed. You will see the difference best if 'fine speed' is mapped to the radius.\n-8.0 very fast speed does not increase 'fine speed' much more\n+8.0 very fast speed increases 'fine speed' a lot\nFor very slow speed the opposite happens."},
  @{cname= "speed2_gamma", name= "Gross speed gamma", constant= 1, min= ~8.0f, def= 4.0f, max= 8.0f, tooltip= "Same as 'fine speed gamma' for gross speed"},
  @{cname= "offset_by_random", name= "Jitter", constant= 0, min= 0.0f, def= 0.0f, max= 25.0f, tooltip= "Add a random offset to the position where each dab is drawn\n 0.0 disabled\n 1.0 standard deviation is one basic radius away\n<0.0 negative values produce no jitter"},
  @{cname= "offset_y", name= "Offset Y", constant= 0, min= ~40.0f, def= 0.0f, max= 40.0f, tooltip= "Moves the dabs up or down based on canvas coordinates."},
  @{cname= "offset_x", name= "Offset X", constant= 0, min= ~40.0f, def= 0.0f, max= 40.0f, tooltip= "Moves the dabs left or right based on canvas coordinates."},
  @{cname= "offset_angle", name= "Angular Offset: Direction", constant= 0, min= ~40.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the stroke direction to offset the dabs to one side."},
  @{cname= "offset_angle_asc", name= "Angular Offset: Ascension", constant= 0, min= ~40.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the tilt direction to offset the dabs to one side. Requires Tilt."},
  @{cname= "offset_angle_view", name= "Angular Offset: View", constant= 0, min= ~40.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the view orientation to offset the dabs to one side."},
  @{cname= "offset_angle_2", name= "Angular Offset Mirrored: Direction", constant= 0, min= 0.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the stroke direction to offset the dabs, but to both sides of the stroke."},
  @{cname= "offset_angle_2_asc", name= "Angular Offset Mirrored: Ascension", constant= 0, min= 0.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the tilt direction to offset the dabs, but to both sides of the stroke. Requires Tilt."},
  @{cname= "offset_angle_2_view", name= "Angular Offset Mirrored: View", constant= 0, min= 0.0f, def= 0.0f, max= 40.0f, tooltip= "Follows the view orientation to offset the dabs, but to both sides of the stroke."},
  @{cname= "offset_angle_adj", name= "Angular Offsets Adjustment", constant= 0, min= ~180.0f, def= 0.0f, max= 180.0f, tooltip= "Change the Angular Offset angle from the default, which is 90 degrees."},
  @{cname= "offset_multiplier", name= "Offsets Multiplier", constant= 0, min= ~2.0f, def= 0.0f, max= 3.0f, tooltip= "Logarithmic multiplier for X, Y, and Angular Offset settings."},
  @{cname= "offset_by_speed", name= "Offset by speed", constant= 0, min= ~3.0f, def= 0.0f, max= 3.0f, tooltip= "Change position depending on pointer speed\n= 0 disable\n> 0 draw where the pointer moves to\n< 0 draw where the pointer comes from"},
  @{cname= "offset_by_speed_slowness", name= "Offset by speed filter", constant= 0, min= 0.0f, def= 1.0f, max= 15.0f, tooltip= "How slow the offset goes back to zero when the cursor stops moving"},
  @{cname= "slow_tracking", name= "Slow position tracking", constant= 1, min= 0.0f, def= 0.0f, max= 10.0f, tooltip= "Slowdown pointer tracking speed. 0 disables it, higher values remove more jitter in cursor movements. Useful for drawing smooth, comic-like outlines."},
  @{cname= "slow_tracking_per_dab", name= "Slow tracking per dab", constant= 0, min= 0.0f, def= 0.0f, max= 10.0f, tooltip= "Similar as above but at brushdab level (ignoring how much time has passed if brushdabs do not depend on time)"},
  @{cname= "tracking_noise", name= "Tracking noise", constant= 1, min= 0.0f, def= 0.0f, max= 12.0f, tooltip= "Add randomness to the mouse pointer; this usually generates many small lines in random directions; maybe try this together with 'slow tracking'"},
  @{cname= "color_h", name= "Color hue", constant= 1, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Color hue"},
  @{cname= "color_s", name= "Color saturation", constant= 1, min= ~0.5f, def= 0.0f, max= 1.5f, tooltip= "Color saturation"},
  @{cname= "color_v", name= "Color value", constant= 1, min= ~0.5f, def= 0.0f, max= 1.5f, tooltip= "Color value (brightness, intensity)"},
  @{cname= "restore_color", name= "Save color", constant= 1, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "When selecting a brush, the color can be restored to the color that the brush was saved with.\n 0.0 do not modify the active color when selecting this brush\n 0.5 change active color towards brush color\n 1.0 set the active color to the brush color when selected"},
  @{cname= "change_color_h", name= "Change color hue", constant= 0, min= ~2.0f, def= 0.0f, max= 2.0f, tooltip= "Change color hue.\n-0.1 small clockwise color hue shift\n 0.0 disable\n 0.5 counterclockwise hue shift by 180 degrees"},
  @{cname= "change_color_l", name= "Change color lightness (HSL)", constant= 0, min= ~2.0f, def= 0.0f, max= 2.0f, tooltip= "Change the color lightness using the HSL color model.\n-1.0 blacker\n 0.0 disable\n 1.0 whiter"},
  @{cname= "change_color_hsl_s", name= "Change color satur. (HSL)", constant= 0, min= ~2.0f, def= 0.0f, max= 2.0f, tooltip= "Change the color saturation using the HSL color model.\n-1.0 more grayish\n 0.0 disable\n 1.0 more saturated"},
  @{cname= "change_color_v", name= "Change color value (HSV)", constant= 0, min= ~2.0f, def= 0.0f, max= 2.0f, tooltip= "Change the color value (brightness, intensity) using the HSV color model. HSV changes are applied before HSL.\n-1.0 darker\n 0.0 disable\n 1.0 brigher"},
  @{cname= "change_color_hsv_s", name= "Change color satur. (HSV)", constant= 0, min= ~2.0f, def= 0.0f, max= 2.0f, tooltip= "Change the color saturation using the HSV color model. HSV changes are applied before HSL.\n-1.0 more grayish\n 0.0 disable\n 1.0 more saturated"},
  @{cname= "smudge", name= "Smudge", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Paint with the smudge color instead of the brush color. The smudge color is slowly changed to the color you are painting on.\n 0.0 do not use the smudge color\n 0.5 mix the smudge color with the brush color\n 1.0 use only the smudge color"},
  @{cname= "paint_mode", name= "Pigment", constant= 0, min= 0.0f, def= 1.0f, max= 1.0f, tooltip= "Subtractive spectral color mixing mode.\n0.0 no spectral mixing\n1.0 only spectral mixing"},
  @{cname= "smudge_transparency", name= "Smudge transparency", constant= 0, min= ~1.0f, def= 0.0f, max= 1.0f, tooltip= "Control how much transparency is picked up and smudged, similar to lock alpha.\n1.0 will not move any transparency.\n0.5 will move only 50% transparency and above.\n0.0 will have no effect.\nNegative values do the reverse"},
  @{cname= "smudge_length", name= "Smudge length", constant= 0, min= 0.0f, def= 0.5f, max= 1.0f, tooltip= "This controls how fast the smudge color becomes the color you are painting on.\n0.0 immediately update the smudge color (requires more CPU cycles because of the frequent color checks)\n0.5 change the smudge color steadily towards the canvas color\n1.0 never change the smudge color"},
  @{cname= "smudge_length_log", name= "Smudge length multiplier", constant= 0, min= 0.0f, def= 0.0f, max= 20.0f, tooltip= "Logarithmic multiplier for the \"Smudge length\" value.\nUseful to correct for high-definition/large brushes with lots of dabs.\nThe longer the smudge length the more a color will spread and will also boost performance dramatically, as the canvas is sampled less often"},
  @{cname= "smudge_bucket", name= "Smudge bucket", constant= 0, min= 0.0f, def= 0.0f, max= 255.0f, tooltip= "There are 256 buckets that each can hold a color picked up from the canvas.\nYou can control which bucket to use to improve variability and realism of the brush.\nEspecially useful with the \"Custom input\" setting to correlate buckets with other settings such as offsets."},
  @{cname= "smudge_radius_log", name= "Smudge radius", constant= 0, min= ~1.6f, def= 0.0f, max= 1.6f, tooltip= "This modifies the radius of the circle where color is picked up for smudging.\n 0.0 use the brush radius\n-0.7 half the brush radius (fast, but not always intuitive)\n+0.7 twice the brush radius\n+1.6 five times the brush radius (slow performance)"},
  @{cname= "eraser", name= "Eraser", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "how much this tool behaves like an eraser\n 0.0 normal painting\n 1.0 standard eraser\n 0.5 pixels go towards 50% transparency"},
  @{cname= "stroke_threshold", name= "Stroke threshold", constant= 1, min= 0.0f, def= 0.0f, max= 0.5f, tooltip= "How much pressure is needed to start a stroke. This affects the stroke input only. MinePaint does not need a minimum pressure to start drawing."},
  @{cname= "stroke_duration_logarithmic", name= "Stroke duration", constant= 0, min= ~1.0f, def= 4.0f, max= 14.0f, tooltip= "How far you have to move until the stroke input reaches 1.0. This value is logarithmic (negative values will not invert the process)."},
  @{cname= "stroke_holdtime", name= "Stroke hold time", constant= 0, min= 0.0f, def= 0.0f, max= 10.0f, tooltip= "This defines how long the stroke input stays at 1.0. After that it will reset to 0.0 and start growing again, even if the stroke is not yet finished.\n2.0 means twice as long as it takes to go from 0.0 to 1.0\n9.9 or higher stands for infinite"},
  @{cname= "custom_input", name= "Custom input", constant= 0, min= ~5.0f, def= 0.0f, max= 5.0f, tooltip= "Set the custom input to this value. If it is slowed down, move it towards this value (see below). The idea is that you make this input depend on a mixture of pressure/speed/whatever, and then make other settings depend on this 'custom input' instead of repeating this combination everywhere you need it.\nIf you make it change 'by random' you can generate a slow (smooth) random input."},
  @{cname= "custom_input_slowness", name= "Custom input filter", constant= 0, min= 0.0f, def= 0.0f, max= 10.0f, tooltip= "How slow the custom input actually follows the desired value (the one above). This happens at brushdab level (ignoring how much time has passed, if brushdabs do not depend on time).\n0.0 no slowdown (changes apply instantly)"},
  @{cname= "elliptical_dab_ratio", name= "Elliptical dab: ratio", constant= 0, min= 1.0f, def= 1.0f, max= 10.0f, tooltip= "Aspect ratio of the dabs; must be >= 1.0, where 1.0 means a perfectly round dab."},
  @{cname= "elliptical_dab_angle", name= "Elliptical dab: angle", constant= 0, min= 0.0f, def= 90.0f, max= 180.0f, tooltip= "Angle by which elliptical dabs are tilted\n 0.0 horizontal dabs\n 45.0 45 degrees, turned clockwise\n 180.0 horizontal again"},
  @{cname= "direction_filter", name= "Direction filter", constant= 0, min= 0.0f, def= 2.0f, max= 10.0f, tooltip= "A low value will make the direction input adapt more quickly, a high value will make it smoother"},
  @{cname= "lock_alpha", name= "Lock alpha", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Do not modify the alpha channel of the layer (paint only where there is paint already)\n 0.0 normal painting\n 0.5 half of the paint gets applied normally\n 1.0 alpha channel fully locked"},
  @{cname= "colorize", name= "Colorize", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Colorize the target layer, setting its hue and saturation from the active brush color while retaining its value and alpha."},
  @{cname= "posterize", name= "Posterize", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Strength of posterization, reducing number of colors based on the \"Posterization levels\" setting, while retaining alpha."},
  @{cname= "posterize_num", name= "Posterization levels", constant= 0, min= 0.01f, def= 0.05f, max= 1.28f, tooltip= "Number of posterization levels (divided by 100).\n0.05 = 5 levels, 0.2 = 20 levels, etc.\nValues above 0.5 may not be noticeable."},
  @{cname= "snap_to_pixel", name= "Snap to pixel", constant= 0, min= 0.0f, def= 0.0f, max= 1.0f, tooltip= "Snap brush dab's center and its radius to pixels. Set this to 1.0 for a thin pixel brush."},
  @{cname= "pressure_gain_log", name= "Pressure gain", constant= 1, min= ~1.8f, def= 0.0f, max= 1.8f, tooltip= "This changes how hard you have to press. It multiplies tablet pressure by a constant factor."}
))

#endif
