extern fun experimental_brush_count(): int = "ext#experimental_brush_count"
implement experimental_brush_count() = 23

extern fun experimental_brush_name(i: int): string = "ext#experimental_brush_name"
implement experimental_brush_name(i) =
  if (i < 0) || (i >= 23) then ""
  else let
    var names = @[string][23](
      "1pixel",
      "pixel_hardink",
      "pixelblocking",
      "basic",
      "subtle_pencil",
      "hard_sting",
      "glow",
      "soft",
      "track",
      "speed_blot",
      "fur",
      "soft_irregular",
      "irregular_ink",
      "bubble",
      "small_blot",
      "particules_3",
      "spaced-blot",
      "hard_blot",
      "sewing",
      "particules_eraser",
      "pick_and_drag",
      "leaves",
      "DNA_brush"
    )
  in
    table_sget(names, 23, i)
  end

