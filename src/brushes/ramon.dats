extern fun ramon_brush_count(): int = "ext#ramon_brush_count"
implement ramon_brush_count() = 28

extern fun ramon_brush_name(i: int): string = "ext#ramon_brush_name"
implement ramon_brush_name(i) =
  if (i < 0) || (i >= 28) then ""
  else let
    var names = @[string][28](
      "B-pencil",
      "2B_pencil",
      "P._Shade",
      "Sketch_1",
      "Soft_Eraser",
      "Hard_Eraser",
      "Thin_Pen",
      "Pen",
      "PenBrush",
      "Marker",
      "Delayed_",
      "100%_Opaque",
      "Round",
      "Round_Bl",
      "BigAirbrush",
      "RS_blendOP",
      "wet_round",
      "Wet_Direction",
      "Classic_Paint",
      "Blur_Fast",
      "Smear",
      "Knife",
      "Grain",
      "Dirty_Noise",
      "Pastel_1",
      "Beamlight",
      "Glow_Airbrush",
      "Clouds"
    )
  in
    table_sget(names, 28, i)
  end

