extern fun dieterle_brush_name(i: int): string = "ext#dieterle_brush_name"
implement dieterle_brush_name(i) =
  if (i < 0) || (i >= 19) then ""
  else let
    var names = @[string][19](
      "8B_Pencil#1",
      "Flat2#1",
      "HalfToneCMY#1",
      "Round#1",
      "arrow#1",
      "Fan#1",
      "Fountain_SF#1",
      "Fount-offset#1",
      "HalfTone#1",
      "Pencil-_Left_Handed",
