extern fun tanda_brush_count(): int = "ext#tanda_brush_count"
implement tanda_brush_count() = 35

extern fun tanda_brush_name(i: int): string = "ext#tanda_brush_name"
implement tanda_brush_name(i) =
  if (i < 0) || (i >= 35) then ""
  else let
    var names = @[string][35](
      "acrylic-03-only-water",
      "acrylic-03-paint",
      "acrylic-03-with-water",
      "acrylic-04-only-water",
      "acrylic-04-paint",
      "acrylic-04-with-water",
      "acrylic-05-only-water",
      "acrylic-05-paint",
      "acrylic-05-with-water",
      "charcoal-01",
      "charcoal-03",
      "charcoal-04",
      "charcoal-blur1",
      "marker-01",
      "marker-05",
      "oil-01-clean",
      "oil-01-paint",
      "oil-03-clean",
      "oil-03-paint",
      "oil-06-clean",
      "oil-06-paint",
      "oil-mop",
      "pencil-2b",
      "pencil-8b",
      "splatter-02",
      "splatter-04",
      "texture-03",
      "texture-06",
      "texture-12",
      "water-01",
      "water-02",
      "water-05",
      "water-06",
      "watercolor-02-paint",
      "watercolor-02-water"
    )
  in
    table_sget(names, 35, i)
  end

