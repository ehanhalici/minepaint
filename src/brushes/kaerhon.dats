extern fun kaerhon_brush_count(): int = "ext#kaerhon_brush_count"
implement kaerhon_brush_count() = 20

extern fun kaerhon_brush_name(i: int): string = "ext#kaerhon_brush_name"
implement kaerhon_brush_name(i) =
  if (i < 0) || (i >= 20) then ""
  else let
    var names = @[string][20](
      "flat_bar_l",
      "inkster_l",
      "extreme_round_l",
      "ink_slow_s",
      "ink-slowline_s",
      "smudge_ink(0.7)_sm",
      "paint_radius_2_sm",
      "Smear_sm",
      "paint_sm",
      "paint_barrr_sm",
      "wet_paint_sm",
      "Dirty_Transparent_sk",
      "classic_sk",
      "airsmudgeultimate_sk",
      "Sketcher2_sk",
      "airsmudge_a",
      "airbruch_press_a",
      "Airbrush_a",
      "classicroundblock_static_c",
      "fill_c"
    )
  in
    table_sget(names, 20, i)
  end

