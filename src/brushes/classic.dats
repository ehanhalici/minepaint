extern fun draw_engine_brush_set_base_value(b: ptr, id: int, v: float): void = "ext#draw_engine_brush_set_base_value"
extern fun draw_engine_brush_set_mapping_n(b: ptr, setting: int, input: int, n: int): void = "ext#draw_engine_brush_set_mapping_n"
extern fun draw_engine_brush_set_mapping_point(b: ptr, setting: int, input: int, index: int, x: float, y: float): void = "ext#draw_engine_brush_set_mapping_point"

extern fun classic_brush_count(): int = "ext#classic_brush_count"
implement classic_brush_count() = 35

extern fun classic_brush_name(i: int): string = "ext#classic_brush_name"
implement classic_brush_name(i) =
  if (i < 0) || (i >= 35) then ""
  else let
    var names = @[string][35](
      "pencil",
      "charcoal",
      "dry_brush",
      "rounded",
      "knife",
      "smudge+paint",
      "ink_eraser",
      "blend+paint",
      "modelling2",
      "modelling",
      "marker_fat",
      "marker_small",
      "kabura",
      "pen",
      "slow_ink",
      "pointy_ink",
      "brush",
      "textured_ink",
      "ink_blot",
      "coarse_bulk_3",
      "coarse_bulk_2",
      "coarse_bulk_1",
      "short_grass",
      "long_grass",
      "bulk",
      "calligraphy",
      "puantilism",
      "puantilism2",
      "impressionism",
      "imp_details",
      "imp_blending",
      "wet_knife",
      "blending_knife",
      "smudge",
      "blur"
    )
  in
    mp_arr_sget(addr@names, i)
  end

